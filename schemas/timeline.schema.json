{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repokit://schemas/timeline",
  "title": "Timeline",
  "description": "Что смонтировать: какие записи, в каком стиле и с какой камерой. Содержимое кадра — только файлы-источники; оформление вокруг — подача.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "output", "style", "scenes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "fps": { "type": "integer", "minimum": 10, "maximum": 60 }
      }
    },
    "style": { "enum": ["light", "dark", "glass"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "description": "Путь к видеозаписи относительно корня репозитория" },
          "events": { "type": "string", "description": "Лог событий записи; нужен для авто-зума и курсора" },
          "in": { "type": "number", "minimum": 0, "description": "Начало фрагмента, секунды" },
          "out": { "type": "number", "exclusiveMinimum": 0, "description": "Конец фрагмента, секунды" },
          "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
          "zoom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["auto", "off"] },
              "scale": { "type": "number", "minimum": 1, "maximum": 4 }
            }
          },
          "cursor": { "type": "boolean" },
          "title": { "type": "string", "maxLength": 80 }
        }
      }
    }
  }
}
