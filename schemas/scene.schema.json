{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repokit://schemas/scene",
  "title": "Scene",
  "description": "Режиссёрская 3D-сцена: устройства с настоящими записями, камера, движение объектов, эффекты. Точки и рамки задаются в CSS-пикселях записанной страницы.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "output", "objects"],
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "x, y на странице, CSS-пиксели" },
    "box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "x, y, ширина, высота на странице, CSS-пиксели" },
    "ease": { "enum": ["linear", "in", "out", "inOut", "back"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "time": { "type": "number", "minimum": 0, "description": "секунды от начала сцены" }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "fps": { "type": "integer", "minimum": 10, "maximum": 60 },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 120, "description": "длина сцены в секундах" }
      }
    },
    "background": {
      "description": "Имя готового фона или собственный CSS",
      "oneOf": [
        { "enum": ["light", "dark", "glass", "sunset", "mint", "mono"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["css"],
          "properties": { "css": { "type": "string" }, "captionColor": { "type": "string" } }
        }
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "device", "media"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "device": { "enum": ["browser", "laptop", "phone", "screen"], "description": "browser и screen принимают форму записи; laptop и phone обрезают её под свой экран" },
          "media": { "type": "string", "description": "Видео или изображение, путь относительно репозитория" },
          "events": { "type": "string", "description": "Лог событий записи: нужен для курсора, авто-камеры и эффектов по кликам" },
          "mediaStart": { "type": "number", "minimum": 0, "description": "С какой секунды записи начинается сцена" },
          "mediaSpeed": { "type": "number", "minimum": 0.25, "maximum": 4 },
          "fit": { "enum": ["cover", "contain"] },
          "width": { "type": "number", "exclusiveMinimum": 0, "description": "Ширина экрана устройства в единицах сцены" },
          "position": { "$ref": "#/$defs/vec3" },
          "rotation": { "$ref": "#/$defs/vec3", "description": "Градусы вокруг осей x, y, z" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "keyframes": {
            "type": "array",
            "description": "Движение объекта. В кадре достаточно указать то, что меняется",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["at"],
              "properties": {
                "at": { "$ref": "#/$defs/time" },
                "position": { "$ref": "#/$defs/vec3" },
                "rotation": { "$ref": "#/$defs/vec3" },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "ease": { "$ref": "#/$defs/ease" }
              }
            }
          },
          "cursor": { "type": "boolean" },
          "effects": {
            "type": "object",
            "description": "Эффекты на каждый клик из лога событий",
            "additionalProperties": false,
            "properties": {
              "ripple": { "type": "boolean" },
              "sparks": { "type": "boolean" },
              "popOut": { "type": "boolean", "description": "Нажатый элемент приподнимается над страницей, продавливается и возвращается" }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fov": { "type": "number", "minimum": 5, "maximum": 100 },
        "auto": {
          "type": "object",
          "description": "Камера сама следует за кликами и вводом, как авто-зум, но настоящим наездом",
          "additionalProperties": false,
          "required": ["object"],
          "properties": {
            "object": { "$ref": "#/$defs/id" },
            "zoom": { "type": "number", "exclusiveMinimum": 0, "description": "Кратность наезда на действие относительно общего плана" },
            "wide": { "type": "number", "exclusiveMinimum": 0, "description": "Зум общего плана: 1 — экран во весь кадр, меньше — с полями" },
            "yaw": { "type": "number" },
            "pitch": { "type": "number" }
          }
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at"],
            "properties": {
              "at": { "$ref": "#/$defs/time" },
              "ease": { "$ref": "#/$defs/ease" },
              "position": { "$ref": "#/$defs/vec3" },
              "lookAt": { "$ref": "#/$defs/vec3" },
              "focus": {
                "type": "object",
                "additionalProperties": false,
                "required": ["object"],
                "properties": {
                  "object": { "$ref": "#/$defs/id" },
                  "point": { "$ref": "#/$defs/point" },
                  "zoom": { "type": "number", "exclusiveMinimum": 0, "description": "1 — экран целиком в кадре; 2 — половина экрана; 0.7 — с полями вокруг устройства" },
                  "yaw": { "type": "number", "minimum": -80, "maximum": 80, "description": "Градусы вбок от взгляда прямо на экран" },
                  "pitch": { "type": "number", "minimum": -80, "maximum": 80, "description": "Градусы вверх" }
                }
              }
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "description": "Эффекты, поставленные вручную",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "object", "at", "point"],
            "properties": {
              "type": { "enum": ["sparks", "ripple"] },
              "object": { "$ref": "#/$defs/id" },
              "at": { "$ref": "#/$defs/time" },
              "point": { "$ref": "#/$defs/point" },
              "count": { "type": "integer", "minimum": 1, "maximum": 120 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "object", "box", "from", "to"],
            "properties": {
              "type": { "const": "popOut" },
              "object": { "$ref": "#/$defs/id" },
              "box": { "$ref": "#/$defs/box" },
              "from": { "$ref": "#/$defs/time" },
              "to": { "$ref": "#/$defs/time" },
              "depth": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "description": "Высота подъёма в долях ширины экрана" }
            }
          }
        ]
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "text"],
        "properties": {
          "from": { "$ref": "#/$defs/time" },
          "to": { "$ref": "#/$defs/time" },
          "text": { "type": "string", "minLength": 1, "maxLength": 90 },
          "position": { "enum": ["top", "bottom"] }
        }
      }
    }
  }
}
