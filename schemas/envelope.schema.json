{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repokit://schemas/envelope",
  "title": "Envelope",
  "description": "Единый конверт ответа любой команды repokit при --json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "command", "version", "ok", "exitCode", "data", "warnings", "humanTodo", "artifacts"],
  "properties": {
    "service": { "type": "string" },
    "command": { "type": "string" },
    "version": { "type": "string" },
    "ok": { "type": "boolean" },
    "exitCode": { "enum": [0, 1, 2, 3], "description": "0 ок, 1 проверка не пройдена, 2 ошибка использования, 3 нужен человек" },
    "data": {},
    "warnings": { "type": "array", "items": { "type": "string" } },
    "humanTodo": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "written"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "written": { "type": "boolean" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string" } }
    }
  }
}
