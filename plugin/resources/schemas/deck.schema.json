{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repokit://schemas/deck",
  "title": "Deck",
  "description": "Набор статичных картинок: слайды презентации или баннер. Тексты — только то, что подтверждено фактами или написано автором.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 400, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 200, "maximum": 2160 }
      }
    },
    "theme": { "enum": ["light", "dark", "glass", "sunset", "mint", "mono"] },
    "footer": { "type": "string", "maxLength": 80 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layout"],
        "properties": {
          "layout": {
            "enum": ["title", "text", "bullets", "image", "split", "chips"],
            "description": "title и split — текст слева, картинка справа; text — заголовок и абзац; bullets — список; image — картинка во весь слайд; chips — плашки технологий"
          },
          "kicker": { "type": "string", "maxLength": 60 },
          "heading": { "type": "string", "maxLength": 120 },
          "body": { "type": "string", "maxLength": 600 },
          "bullets": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 160 } },
          "image": { "type": "string", "description": "Изображение, путь относительно репозитория" },
          "frame": { "enum": ["browser", "phone", "none"] },
          "caption": { "type": "string", "maxLength": 160 },
          "chips": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label"],
                  "properties": { "label": { "type": "string" }, "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" } }
                }
              ]
            }
          }
        }
      }
    }
  }
}
